{
  "openapi": "3.1.0",
  "info": {
    "title": "{{host}}",
    "version": "1",
    "summary": "Website icons as sanitized SVG, with theme colours in the headers.",
    "description": "One GET returns a site's icon as an edge-to-edge SVG, in colour or as a black monochrome mask. No key, no query parameters, CORS open. The response is an SVG even when the site has no usable icon; the headers explain why.",
    "license": { "name": "MIT", "identifier": "MIT" }
  },
  "servers": [{ "url": "{{origin}}" }],
  "externalDocs": {
    "description": "Full HTTP contract",
    "url": "https://github.com/peleda-app/favicons/blob/main/docs/API.md"
  },
  "paths": {
    "/{style}/{domain}": {
      "get": {
        "operationId": "getIcon",
        "summary": "Icon of a website",
        "parameters": [
          {
            "name": "style",
            "in": "path",
            "required": true,
            "description": "color: the site's own colours. mono: one black shape on transparent, for CSS masks.",
            "schema": { "type": "string", "enum": ["color", "mono"] }
          },
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "description": "Registrable domain, e.g. github.com. Any other form gets a 301 to it.",
            "schema": { "type": "string", "examples": ["discord.com"] }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "A real icon, or a generated one when X-Icon-Fallback-Reason is present.",
            "headers": {
              "ETag": { "schema": { "type": "string" } },
              "X-Icon-Source": { "schema": { "type": "string", "enum": ["cache", "origin", "generated"] } },
              "X-Icon-Domain": { "schema": { "type": "string" } },
              "X-Icon-Style": { "schema": { "type": "string", "enum": ["color", "mono"] } },
              "X-Icon-Vector": { "schema": { "type": "string", "enum": ["original", "traced", "generated"] } },
              "X-Icon-Provenance": { "schema": { "type": "string", "enum": ["bimi", "thesvg", "site", "upstream"] } },
              "X-Icon-Fallback-Reason": {
                "schema": {
                  "type": "string",
                  "enum": ["queued", "overloaded", "fetch-failed", "not-found", "domain-too-new", "blocklisted", "dns-blocked", "no-monochrome", "invalid-domain"]
                }
              },
              "X-Icon-Blocked": { "schema": { "type": "string", "enum": ["blocklist", "dns-filter"] } },
              "X-Icon-Shape": { "schema": { "type": "string", "enum": ["square", "rounded", "circle", "none"] } },
              "X-Icon-Fill": { "schema": { "type": "string", "enum": ["bleed", "inset"] } },
              "X-Icon-Accent": { "$ref": "#/components/headers/Colour" },
              "X-Icon-Light-Plate": { "$ref": "#/components/headers/Colour" },
              "X-Icon-Light-Text": { "$ref": "#/components/headers/Colour" },
              "X-Icon-Light-Mono": { "$ref": "#/components/headers/Colour" },
              "X-Icon-Light-Mono-Plate": { "$ref": "#/components/headers/Colour" },
              "X-Icon-Dark-Plate": { "$ref": "#/components/headers/Colour" },
              "X-Icon-Dark-Text": { "$ref": "#/components/headers/Colour" },
              "X-Icon-Dark-Mono": { "$ref": "#/components/headers/Colour" },
              "X-Icon-Dark-Mono-Plate": { "$ref": "#/components/headers/Colour" },
              "Server-Timing": { "schema": { "type": "string", "examples": ["app;dur=0.83"] } }
            },
            "content": { "image/svg+xml": { "schema": { "type": "string" } } }
          },
          "301": { "description": "Non-canonical domain or path; Location holds the canonical URL." },
          "304": { "description": "If-None-Match matched." },
          "404": { "description": "Unknown style or path." },
          "429": { "description": "Rate limit for this network; retry after Retry-After seconds." },
          "503": { "description": "Overloaded or timed out; retry shortly." }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "summary": "Liveness",
        "responses": { "200": { "description": "ok", "content": { "text/plain": { "schema": { "type": "string" } } } } }
      }
    }
  },
  "components": {
    "headers": {
      "Colour": {
        "description": "#rrggbb",
        "schema": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
      }
    }
  }
}
